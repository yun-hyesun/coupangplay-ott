rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function session(sessionId) { return get(/databases/$(database)/documents/watchSessions/$(sessionId)); }
    function memberPath(sessionId, uid) { return /databases/$(database)/documents/watchSessions/$(sessionId)/members/$(uid); }
    function activeMember(sessionId) {
      return signedIn()
        && exists(memberPath(sessionId, request.auth.uid))
        && session(sessionId).data.status == 'active';
    }
    function validProfileId(profileId) {
      return profileId is string && profileId.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    function ownsWatchProfile(profileId) {
      return validProfileId(profileId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profiles/$(profileId));
    }
    function watchProfilePath(sessionId, profileId) {
      let memberId = request.auth.uid + ':' + profileId;
      return /databases/$(database)/documents/watchSessions/$(sessionId)/profileMembers/$(memberId);
    }
    function activeWatchProfile(sessionId, profileId) {
      return activeMember(sessionId) && validProfileId(profileId)
        && exists(watchProfilePath(sessionId, profileId))
        && !('kickedAt' in get(watchProfilePath(sessionId, profileId)).data);
    }
    match /contents/{contentId}/episodes/{episodeId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId','authorName','text','rating','spoiler','likes','createdAt','updatedAt','isEdited'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.rating * 2 == int(request.resource.data.rating * 2)
        && request.resource.data.spoiler is bool
        && request.resource.data.likes == 0
        && request.resource.data.isEdited == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt','isEdited'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.isEdited == true;
      // 좋아요 카운트와 본인 참여 기록은 반드시 한 트랜잭션으로 생성합니다.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && resource.data.likes is int && resource.data.likes >= 0
        && request.resource.data.likes == resource.data.likes + 1
        && !exists(/databases/$(database)/documents/contents/$(contentId)/episodes/$(episodeId)/reviews/$(reviewId)/likes/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/contents/$(contentId)/episodes/$(episodeId)/reviews/$(reviewId)/likes/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/contents/$(contentId)/episodes/$(episodeId)/reviews/$(reviewId)/likes/$(request.auth.uid)).data.createdAt == request.time;
      match /likes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/contents/$(contentId)/episodes/$(episodeId)/reviews/$(reviewId)).data.likes is int
          && getAfter(/databases/$(database)/documents/contents/$(contentId)/episodes/$(episodeId)/reviews/$(reviewId)).data.likes
            == get(/databases/$(database)/documents/contents/$(contentId)/episodes/$(episodeId)/reviews/$(reviewId)).data.likes + 1;
        allow update, delete: if false;
      }
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
    match /watchSessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['contentId','episodeId','hostId','hostProfileId','status','createdAt','endedAt'])
        && request.resource.data.hostId == request.auth.uid
        && ownsWatchProfile(request.resource.data.hostProfileId)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.endedAt == null;
      // 세션 정보는 참여 전에 조회할 수 있어야 초대 링크로 입장할 수 있습니다.
      allow get: if signedIn();
      allow list: if false;
      allow update: if signedIn() && resource.data.hostId == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt'])
        && request.resource.data.status == 'ended'
        && request.resource.data.endedAt == request.time;
      allow delete: if false;
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if activeMember(sessionId);
        allow create: if signedIn() && request.auth.uid == uid
          && session(sessionId).data.status == 'active'
          && request.resource.data.keys().hasOnly(['uid','name','role','joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.role == (session(sessionId).data.hostId == uid ? 'host' : 'member')
          && request.resource.data.joinedAt == request.time;
        allow update, delete: if false;
      }
      match /profileMembers/{memberId} {
        allow get: if signedIn() && (memberId.split(':')[0] == request.auth.uid || activeMember(sessionId));
        allow list: if activeMember(sessionId);
        allow create: if signedIn()
          && session(sessionId).data.status == 'active'
          && existsAfter(memberPath(sessionId, request.auth.uid))
          && request.resource.data.keys().hasOnly(['uid','profileId','name','role','joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && ownsWatchProfile(request.resource.data.profileId)
          && memberId == request.auth.uid + ':' + request.resource.data.profileId
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.role == (session(sessionId).data.hostId == request.auth.uid
            && session(sessionId).data.get('hostProfileId', request.resource.data.profileId) == request.resource.data.profileId ? 'host' : 'member')
          && request.resource.data.joinedAt == request.time;
        allow update: if activeMember(sessionId)
          && session(sessionId).data.hostId == request.auth.uid
          && resource.data.role == 'member' && !('kickedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kickedAt'])
          && request.resource.data.kickedAt == request.time;
        allow delete: if false;
      }
      match /presence/{connectionId} {
        allow read: if activeMember(sessionId);
        allow create, update: if activeWatchProfile(sessionId, request.resource.data.profileId)
          && request.resource.data.keys().hasOnly(['uid','profileId','seenAt'])
          && request.resource.data.uid == request.auth.uid
          && (resource == null || (resource.data.uid == request.auth.uid && resource.data.profileId == request.resource.data.profileId))
          && request.resource.data.seenAt == request.time;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      match /messages/{messageId} {
        allow read: if activeMember(sessionId);
        allow create: if activeWatchProfile(sessionId, request.resource.data.senderProfileId)
          && request.resource.data.keys().hasOnly(['senderId','senderProfileId','senderName','text','type','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.type == 'text'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    // 이 파일은 커뮤니티 컬렉션의 규칙 예시입니다. 기존 프로젝트의 다른
    // 컬렉션(users, profiles 등) 규칙과 병합한 후 배포해야 합니다.
  }
}
